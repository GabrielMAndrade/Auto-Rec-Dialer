# =========================================================
# AUTO RECICLAGEM - DISCAdor
# Este arquivo pode ser commitado. NÃO coloque secrets reais aqui.
# =========================================================

# Ambiente 3C do Discador
DIALER_BASE_URL=https://somasoluoes.3c.plus
DIALER_EMAIL=seu_email
DIALER_PASSWORD=sua_senha
DIALER_TOTP_SECRET=sua_secret_base32_sem_espacos

# Token exclusivo deste serviço para o n8n
DIALER_N8N_API_TOKEN=troque_por_um_token_forte_e_diferente_da_ura

# API independente da URA
DIALER_HOST=0.0.0.0
DIALER_PORT=6777

# Selenium / Chrome
HEADLESS=true
CHROME_BINARY=
CHROMEDRIVER_PATH=

# Tempos
SELENIUM_TIMEOUT=30
RECYCLE_SLEEP_SECONDS=5
AUTOMATION_ACTION_DELAY_SECONDS=0.7
AUTOMATION_STAGE_DELAY_SECONDS=0.35

# Colunas da tabela do Discador
# Confirmadas/inferidas pelo layout atual:
# td[2] = nome
# td[3] = quantidade de clientes
# td[6] = taxa de abandono (%)
# td[7] = data de finalização
DIALER_COL_NOME=2
DIALER_COL_CLIENTES=3
DIALER_COL_ABANDONO=6
DIALER_COL_DATA_FINALIZACAO=7

# REGRA DE PARADA
# Só NÃO recicla quando:
# taxa_abandono < 1.0 E percentual_restante < 0.66
DIALER_ABANDONO_STOP_PERCENT=1.0
DIALER_REMAINING_STOP_RATIO=0.66
